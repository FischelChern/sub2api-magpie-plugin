{
  "name": "sub2api-magpie-plugin",
  "version": "0.4.7",
  "description": "Magpie provider for Sub2API: subscriptions, balance, models, four API protocols and custom request headers",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "image.png",
    "README.md",
    "README.en.md",
    "LICENSE",
    "examples/options.json"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "magpie-plugin",
    "sub2api",
    "provider"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "magpie": {
    "icon": "./image.png",
    "options": {
      "protocol": "auto",
      "headers": {},
      "protocolHeaders": {},
      "modelProtocols": {},
      "apiPaths": {},
      "sites": [],
      "diagnostics": false,
      "query": {},
      "modelNames": {},
      "modelOverrides": {},
      "excludeModels": []
    }
  }
}
